    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.BlazorWebView" Version="0.1.0-preview.14.26531.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slipswitch\Slipswitch.csproj" />
  </ItemGroup>

</Project>
